<!DOCTYPE html>
@*
    Comments
*@
@model IEnumerable<LexV2QnABotApp.Models.MessageViewModel>
@{
    ViewData["Title"] = ".NET Lex ChatBot";
}

<html>
<head>
    
    <title>.NET Amazon Lex ChatBot - Sample Application (OrderFlowers)</title>
    <script src="https://sdk.amazonaws.com/js/aws-sdk-2.41.0.min.js"></script>
    <script src="~/js/chatbot/jquery-1.10.2.js" type="text/javascript"></script>
    <script src="~/js/chatbot/jquery-ui-1.10.4.custom.min.js" type="text/javascript"></script>
    <script ssrc="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js"></script>
    <script src="~/js/chatbot/awesome-landing-page.js" type="text/javascript"></script>
    <style language="text/css">
        input#wisdom {
            padding: 4px;
            font-size: 1em;
            width: 400px
        }

        input::placeholder {
            color: #ccc;
            font-style: italic;
        }

        ::-webkit-input-placeholder { /* WebKit, Blink, Edge */
            color: #ccc;
            font-style: italic;
        }

        :-moz-placeholder { /* Mozilla Firefox 4 to 18 */
            color: #ccc;
            font-style: italic;
        }

        ::-moz-placeholder { /* Mozilla Firefox 19+ */
            color: #909;
            opacity: 1;
        }

        :-ms-input-placeholder { /* Internet Explorer 10-11 */
            color: #ccc;
            font-style: italic;
        }

        ::-ms-input-placeholder { /* Microsoft Edge */
            color: #ccc;
            font-style: italic;
        }

        dt.userRequest {
            margin: 4px;
            padding: 4px 10px 4px 10px;
            border-radius: 4px;
            min-width: 50%;
            max-width: 85%;
            float: left;
            background-color: #7d7;
        }

        dd.lexResponse {
            margin: 4px;
            padding: 4px 10px 4px 10px;
            border-radius: 4px;
            text-align: left;
            min-width: 50%;
            max-width: 85%;
            float: left;
            background-color: #bbf;
            font-style: italic;
        }

        button.lexResponse {
            margin: 4px;
            padding: 4px 10px 4px 10px;
            border-radius: 4px;
            text-align: left;
            min-width: 30%;
            float: left;
            background-color: #bbf;
            font-style: italic;
        }

        td.button-cell {
            margin: 4px;
            padding: 4px 10px 4px 10px;
        }

        p.lexError {
            margin: 4px;
            padding: 4px 10px 4px 10px;
            border-radius: 4px;
            text-align: right;
            min-width: 50%;
            max-width: 85%;
            float: right;
            background-color: #f77;
        }
    </style>
    <!--     Fonts and icons     -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href='http://fonts.googleapis.com/css?family=Open+Sans:300italic,400,300' rel='stylesheet' type='text/css' />
</head>
<body>
    <section class ="gradient-custom">
    <div class="wrapper">

            
            <div class="container py-5">
                <div class="row">
                    <div class="col-md-7">
                        <div class="parallax-image" class="col-md-7">
                            <div id="chatheader" style="width: auto;height: 60px;border: 1px solid gray;background-color: cadetblue;border-radius: 10px">
                                <img src="~/images/awspowered-sm.png" style="float:left; margin-top:2px;max-height:95%; max-width:20%;border: 1px solid #7b7b7b;border-radius: 50%;" />
                                <h4 style="margin-top:15px;float:left;padding-left:5px;color:white">Ask a Query</h4>
                            </div>
                            <div  id="conversation" style="height: 450px; border: 2px solid gray;background-color: #ffffff; overflow: scroll;object-position:bottom">
                                <dl class="col-md-7" style="width: 58.33333333%;">
                                    @foreach (var ChatMsg in Model)
                                    {
                                        
                                            <dd class="lexResponse">@ChatMsg.ChatMessage</dd>
                                        
                                        @if (ChatMsg.ResponseMessageType == "ImageResponseCard")
                                        {
                                            
                                            <dd class="lexResponse">@ChatMsg.ResponseCardViewModel.Title</dd>
                                           <dt></dt>
                                            <dd><button id="btn1" class=".btn lexResponse" value="@ChatMsg.ResponseCardViewModel.reponseCardMessages[0]" onclick="SubmitFunction(this)">@ChatMsg.ResponseCardViewModel.reponseCardMessages[0]</button></dd>
                                        }
                                        
                                        
                                    }
                                </dl>
                            </div>
                            @{
                                <script type="text/javascript">
                                    var chatDiv = document.getElementById("conversation");
                                    chatDiv.scrollTop = chatDiv.scrollHeight;



                                    function SubmitFunction(element) {
                                        $("#userMessage").val($(element).val());
                                        $("form").submit();
                                    }
                                </script>
                                <script src="~/lib/jquery/dist/jquery.min.js"></script>
                                <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
                                <script src="~/js/site.js" asp-append-version="true"></script>

                                var htmlAttributes = new Dictionary<string, object>();
                                htmlAttributes.Add("class", "form-inline");
                            }

                            @using (Html.BeginForm("GetChatMessage", "ChatBot", FormMethod.Post, htmlAttributes))
                            {
                                <div >
                                    <input class="form-control" id="userMessage" name="userMessage" type="text" placeholder="Enter your chat here" style="float:right;z-index:-1;background-color: #ffffff;height:39px" />
                                    <a asp-action="ClearBot" class="btn btn-primary" role="button" style="background-color:cadetblue;float:right;margin-top:-39px;color:white">Clear</a>
                                </div>
                            }
                        </div>

                    </div>
                </div>
            </div>
    </div>
    </section>
</body>
</html>